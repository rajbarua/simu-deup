fullnameOverride: {{ hazelcast_helm_release_name }}

image:
  repository: hazelcast/hazelcast-enterprise
  tag: {{ hazelcast_version | quote }}
  pullPolicy: IfNotPresent

cluster:
  memberCount: {{ primary_cluster_size | int }}

nodeSelector:
  component: {{ hz_cluster_node_pool }}

resources:
  requests:
    cpu: {{ hazelcast_cpu_request | quote }}
    memory: {{ hazelcast_memory_request }}
  limits:
    memory: {{ hazelcast_memory_limit }}

hazelcast:
  licenseKeySecretName: {{ hazelcast_license_secret_name }}
  javaOpts: >-
    -Xms{{ hazelcast_jvm_heap }}
    -Xmx{{ hazelcast_jvm_heap }}
    -Xlog:gc*
    -Dhazelcast.config=/data/external/hazelcast.yaml
  yaml:
    hazelcast:
      cluster-name: {{ hazelcast_helm_release_name }}
      network:
        join:
          multicast:
            enabled: false
          kubernetes:
            enabled: true
            service-name: ${serviceName}
            namespace: ${namespace}
            expose-externally: true
            service-per-pod-label-name: com.hazelcast/external-access
            service-per-pod-label-value: "true"
        rest-api:
          enabled: true
      properties:
        hazelcast.slow.operation.detector.enabled: true
        hazelcast.shutdownhook.policy: GRACEFUL
      management-center:
        scripting-enabled: true
      persistence:
        enabled: false
      cp-subsystem:
        cp-member-count: {{ primary_cluster_size | int }}
        group-size: {{ primary_cluster_size | int }}
        persistence-enabled: true
        base-dir: /data/persistence/cp
        data-load-timeout-seconds: {{ cp_data_load_timeout_seconds | int }}
        cp-member-priority: 0
        auto-step-down-when-leader: __AUTO_STEP_DOWN__
        raft-algorithm:
          commit-index-advance-count-to-snapshot: {{ cp_raft_snapshot_commit_interval | int }}
      native-memory:
        enabled: true
        allocator-type: POOLED
        capacity:
          unit: GIGABYTES
          value: {{ hazelcast_native_memory_size | regex_replace('Gi$', '') | int }}
        min-block-size: {{ hazelcast_native_memory_min_block_size | int }}
        page-size: {{ hazelcast_native_memory_page_size | int }}
        metadata-space-percentage: {{ hazelcast_native_memory_metadata_space_percentage }}
      jet:
        enabled: true
        resource-upload-enabled: true
      serialization:
        compact-serialization:
          serializers:
            - serializer: com.hazelcast.simudedupe.jet.DedupRequestCompactSerializer
            - serializer: com.hazelcast.simudedupe.jet.DedupResultCompactSerializer
            - serializer: com.hazelcast.simudedupe.jet.OperationIdPrefixPredicateCompactSerializer
            - serializer: com.hazelcast.simudedupe.jet.DedupResultStatsAggregatorCompactSerializer
            - serializer: com.hazelcast.simudedupe.jet.PostgresPrefixCountTaskCompactSerializer
            - serializer: com.hazelcast.simudedupe.merchantprofile.MerchantProfileCompactSerializer
            - serializer: com.hazelcast.simudedupe.merchantprofile.PostgresRunMarkerCountTaskCompactSerializer
      data-connection:
        {{ dedup_postgres_data_connection }}:
          type: JDBC
          properties:
            jdbcUrl: {{ dedup_postgres_jdbc_url }}
            user: {{ dedup_postgres_username }}
            password: __POSTGRES_PASSWORD__
          shared: true
      map:
        {{ dedup_map_name }}:
          backup-count: 1
          in-memory-format: NATIVE
          time-to-live-seconds: {{ dedup_map_ttl_seconds | int }}
          map-store:
            enabled: true
            class-name: com.hazelcast.simudedupe.store.TransactionDeduplicationMapStore
            initial-mode: EAGER
            write-delay-seconds: 1
            write-batch-size: {{ dedup_mapstore_batch_size | int }}
            write-coalescing: true
            properties:
              tableName: {{ dedup_table_name }}
              connectionName: {{ dedup_postgres_data_connection }}
              batchSize: {{ dedup_mapstore_batch_size | quote }}
              ttlSeconds: {{ dedup_map_ttl_seconds | quote }}
        {{ jet_input_map_name }}:
          backup-count: 1
          in-memory-format: NATIVE
          time-to-live-seconds: {{ jet_transient_map_ttl_seconds | int }}
          event-journal:
            enabled: true
            capacity: {{ jet_event_journal_capacity | int }}
            time-to-live-seconds: {{ jet_event_journal_ttl_seconds | int }}
        {{ jet_result_map_name }}:
          backup-count: 1
          in-memory-format: NATIVE
          time-to-live-seconds: {{ jet_transient_map_ttl_seconds | int }}
        {{ merchant_profile_map_name }}:
          backup-count: 1
          in-memory-format: NATIVE
          time-to-live-seconds: {{ merchant_profile_map_ttl_seconds | int }}
          map-store:
            enabled: true
            class-name: com.hazelcast.simudedupe.store.MerchantProfileMapStore
            initial-mode: LAZY
            write-delay-seconds: 1
            write-batch-size: {{ merchant_profile_mapstore_batch_size | int }}
            write-coalescing: true
            properties:
              tableName: {{ merchant_profile_table_name }}
              connectionName: {{ dedup_postgres_data_connection }}
              batchSize: {{ merchant_profile_mapstore_batch_size | quote }}
              ttlSeconds: {{ merchant_profile_map_ttl_seconds | quote }}

jet:
  enabled: true

persistence:
  enabled: true
  accessModes:
    - ReadWriteOnce
  size: {{ cp_persistence_storage_size }}
  storageClass: {{ cp_persistence_storage_class }}

customVolume:
  configMap:
    name: {{ simu_dedup_user_code_config_map }}

externalVolume:
  emptyDir: {}

initContainers:
  - name: wait-for-member-load-balancer
    image: {{ hazelcast_kubectl_image }}
    imagePullPolicy: IfNotPresent
    command:
      - /bin/sh
      - -ec
    args:
      - |
        until address="$(kubectl get service "${POD_NAME}" -n "${POD_NAMESPACE}" -o jsonpath='{.status.loadBalancer.ingress[0].ip}' 2>/dev/null)" && [ -n "${address}" ]; do
          sleep 8
        done
    env:
      - name: POD_NAME
        valueFrom:
          fieldRef:
            fieldPath: metadata.name
      - name: POD_NAMESPACE
        valueFrom:
          fieldRef:
            fieldPath: metadata.namespace
  - name: configure-cp-leadership
    image: busybox:1.36
    imagePullPolicy: IfNotPresent
    command:
      - /bin/sh
      - -ec
    args:
      - |
        step_down=false
        if [ "{{ cp_auto_step_down_enabled | bool | lower }}" = "true" ] && [ "${POD_NAME##*-}" = "{{ cp_auto_step_down_member_ordinal }}" ]; then
          step_down=true
        fi
        if [ -z "${POSTGRES_PASSWORD:-}" ]; then
          echo "POSTGRES_PASSWORD is empty or missing from postgres-auth" >&2
          exit 1
        fi
        awk -v step_down="${step_down}" '
          BEGIN {
            password = ENVIRON["POSTGRES_PASSWORD"]
            gsub(/\047/, "\047\047", password)
          }
          {
            gsub(/__AUTO_STEP_DOWN__/, step_down)
            if (index($0, "password: __POSTGRES_PASSWORD__")) {
              sub(/password: __POSTGRES_PASSWORD__.*/, "")
              print $0 "password: \047" password "\047"
              next
            }
            print
          }
        ' /data/hazelcast/hazelcast.yaml > /data/external/hazelcast.yaml
        if grep -q '__AUTO_STEP_DOWN__\|__POSTGRES_PASSWORD__' /data/external/hazelcast.yaml; then
          echo "Hazelcast configuration contains an unresolved deployment placeholder" >&2
          exit 1
        fi
        chmod 600 /data/external/hazelcast.yaml
    env:
      - name: POD_NAME
        valueFrom:
          fieldRef:
            fieldPath: metadata.name
      - name: POSTGRES_PASSWORD
        valueFrom:
          secretKeyRef:
            name: postgres-auth
            key: POSTGRES_PASSWORD
    volumeMounts:
      - name: hazelcast-storage
        mountPath: /data/hazelcast
      - name: hazelcast-external
        mountPath: /data/external

env:
  - name: POSTGRES_PASSWORD
    valueFrom:
      secretKeyRef:
        name: postgres-auth
        key: POSTGRES_PASSWORD

externalAccess:
  enabled: true
  service:
    type: LoadBalancer
    annotations:
      networking.gke.io/load-balancer-type: Internal
    labels:
      com.hazelcast/external-access: "true"

mancenter:
  enabled: true
  image:
    repository: hazelcast/management-center
    tag: {{ hazelcast_mc_version | quote }}
    pullPolicy: IfNotPresent
  licenseKeySecretName: {{ hazelcast_license_secret_name }}
  javaOpts: >-
    -Dhazelcast.mc.port=8080
    -Xms{{ management_center_jvm_heap }}
    -Xmx{{ management_center_jvm_heap }}
  nodeSelector:
    component: {{ mc_cluster_node_pool }}
  resources:
    requests:
      cpu: {{ management_center_cpu_request | quote }}
      memory: {{ management_center_memory_request }}
  persistence:
    enabled: true
    accessModes:
      - ReadWriteOnce
    size: 1Gi
  service:
    type: LoadBalancer
    port: 8080
  yaml:
    hazelcast-client:
      cluster-name: {{ hazelcast_helm_release_name }}
      network:
        kubernetes:
          enabled: true
          service-name: ${serviceName}
          namespace: ${namespace}
  clusterConfig:
    create: true

test:
  enabled: false
